model Todo {
  id          String   @id @default(uuid())
  title       String
  description String?  @default("")
  status      String   @default("todo")
  dueDate     DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}